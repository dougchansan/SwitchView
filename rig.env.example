# Copy to rig.env (git-ignored) and adjust; tools/switchview.command reads it.
# ESP32-S2 running the pro-2 firmware (ns2-savekit tools/esp32_pro): pad over HTTP,
# and its UART bridge to the Flipper types through Bad KB.
SV_HOST=http://192.168.50.215
# Capture card by name (part of it is enough); phones are never picked.
SV_VIDEO="USB3.0 Video"
# Or watch the capture card over the network through the Raspberry Pi relay (pi/).
#SV_STREAM=switchview-pi.local
# Fingerbot HTTP server (ns2jb-rpc fingerbot/fingerbot.py serve --port 8080).
# tools/switchview.command starts $NS2_DIR/fingerbot/serve.command if nothing answers.
SV_FINGERBOT=http://127.0.0.1:8080
# Optional: fingerbot server folder if it is not $NS2_DIR/fingerbot.
#SV_FINGERBOT_DIR=/Users/douglaswhittingham/ns2jb-rpc/fingerbot
# Optional: press depth to set before power actions (needed after reseating the arm).
#SV_FINGERBOT_TRAVEL=100
# Optional: power-button hold (s) that raises the power menu for Power Menu / Fast Restart (default 5).
#SV_MENU_S=5
# Optional: Seedsow tile (Lua pattern) and a tile to skip.
#SV_SEEDSOW_TILE=seedsow
#SV_SEEDSOW_AVOID=demo
# Optional: Bad KB key hold/gap in ms (default 10); raise it if the console drops characters.
#SV_FLIPPER_KEY_MS=20
# Optional: Bad KB lead-in / load / close waits in ms (defaults 900 / 650 / 350).
# These are the fixed gap between typed commands. Raise START if the first
# characters of a command get dropped; raise LOAD if Bad KB misses the script.
#SV_FLIPPER_START_MS=900
#SV_FLIPPER_LOAD_MS=650
#SV_FLIPPER_CLOSE_MS=350
# Optional: command for the panel's "Seedsow log" tab (default: kalua-sow watch-pretty.py).
#SV_COMPANION="tail -n 50 -F /tmp/ns2-direct-attempts/attempt-1.log"
# NS2 host folder (run.cjs) for the "NS2 Run" button (scripts/smilebasic_runner.lua).
#NS2_DIR=$HOME/ns2jb-rpc
export SV_HOST SV_VIDEO SV_STREAM SV_FINGERBOT SV_FINGERBOT_DIR SV_FINGERBOT_TRAVEL SV_MENU_S SV_SEEDSOW_TILE SV_SEEDSOW_AVOID SV_FLIPPER_KEY_MS SV_FLIPPER_START_MS SV_FLIPPER_LOAD_MS SV_FLIPPER_CLOSE_MS SV_COMPANION NS2_DIR
